# Downloaded sources. Fetched by `make sources`, large, and owned by their
# publishers. What the pipeline derives from them lives in data/sources and IS
# committed, so a fresh clone rebuilds without re-downloading.
data/raw/

# Pipeline scratch output. The bundles the site actually deploys are copied to
# web/public/data by `make web`, and those ARE committed so the host only has
# to run the JavaScript build.
data/out/

