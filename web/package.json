{
  "name": "callejero-feminista",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Who the streets are named after: a designatum atlas of the city callejero.",
  "scripts": {
    "prebuild": "node scripts/build-info.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "bundle": "vite build --mode single && node scripts/inline-data.mjs",
    "artifact": "npm run bundle && node scripts/artifact.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
